{
  "apiVersion": "1",
  "id": "community.fotospass",
  "name": "FotoSpaß",
  "description": "Fotobox mit Galerie, PNG-Accessoires und optionalem Fotodruck über die MuPiBox.",
  "author": "Striker62",
  "version": "0.5.8",
  "runtime": "web",
  "entry": "index.html",
  "permissions": [
    "camera",
    "photo-save",
    "shared-assets",
    "photo-print"
  ],
  "display": {
    "orientation": "landscape",
    "minWidth": 800,
    "minHeight": 480,
    "showBackButton": false
  },
  "sharedDirectories": [
    "accessoires"
  ],
  "cover": "cover.jpg",
  "icon": "icon.png"
}
